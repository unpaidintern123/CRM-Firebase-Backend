# Copy to .env and fill with real values from Firebase Console / GCP IAM.
# NEVER commit .env or paste real private keys into this file.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_KEY_FROM_FIREBASE_CONSOLE\n-----END PRIVATE KEY-----\n"

CRM_SYNC_SHEET_ID=your-main-crm-spreadsheet-id
CRM_LEADS_SHEET_NAME=Leads Data
CRM_FOLLOWUP_LOGS_SHEET_NAME=Follow-up Logs
CRM_CONSULTATION_LOGS_SHEET_NAME=Consultation Booked Logs

# Consultation FMS + After Consultation source spreadsheet
CONSULTATION_SYNC_SPREADSHEET_ID=your-consultation-fms-spreadsheet-id

# MIS weekly scores (team dashboards)
MIS_SPREADSHEET_ID=your-mis-spreadsheet-id
MIS_SHEET_NAME=MIS Data

# Order Forms reconciliation
ORDER_FORMS_SPREADSHEET_ID=your-order-forms-spreadsheet-id
ORDER_FORMS_SHEET_NAME=Order Forms

CRM_EOD_TIMEZONE=Asia/Kolkata
API_SHARED_TOKEN=replace-with-secure-token

# Used by perf-update-lead.mjs only
CRM_API_BASE_URL=https://your-cloud-function-url
TEST_LEAD_ID=
